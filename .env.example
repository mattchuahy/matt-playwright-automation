# Example .env file for local development
# Copy this file to .env and replace the values with the real credentials
# IMPORTANT: Do NOT commit the .env file. It's already added to .gitignore by the test setup.

TEST_USERNAME=your_username_here
TEST_PASSWORD=your_password_here

# For CI: set TEST_USERNAME and TEST_PASSWORD as secure/protected variables in your pipeline (GitHub Actions, Azure Pipelines, etc.)
